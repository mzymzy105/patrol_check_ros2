<?xml version="1.0" ?>
<robot name="robot_sweeper">
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- 原点（地面投影） -->
  <link name="base_footprint"/>

  <!-- 圆形机身：直径 0.33m，高 0.09m，中心离地 0.065m -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.09" radius="0.165"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.09" radius="0.165"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <!-- 顶部激光雷达 -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <geometry><cylinder length="0.025" radius="0.035"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.025" radius="0.035"/></geometry>
    </collision>
  </link>

  <!-- 左轮：轮径 0.06m，轮距 ±0.1m -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.10 -0.035" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <geometry><cylinder length="0.02" radius="0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.02" radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.10 -0.035" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <geometry><cylinder length="0.02" radius="0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.02" radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- 前方万向支撑轮 -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.10 0 -0.053" rpy="0 0 0"/>
  </joint>
  <link name="caster_link">
    <collision>
      <geometry><sphere radius="0.012"/></geometry>
    </collision>
  </link>
</robot>
